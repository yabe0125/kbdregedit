<Window x:Class="KbdLayoutTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KbdLayoutTool.App"
        mc:Ignorable="d"
        Title="キーボードレイアウト オーバーライド ツール" Height="560" Width="940"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">

        <!-- Toolbar -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button x:Name="RescanButton" Content="🔄 再スキャン" Click="OnRescan" Padding="8,4"/>
                <Separator/>
                <Button x:Name="JisButton" Content="日本語 JIS (7/2)" Click="OnApplyJis" Padding="8,4"/>
                <Button x:Name="UsButton" Content="英語 US (4/0)" Click="OnApplyUs" Padding="8,4"/>
                <Button x:Name="ClearButton" Content="override 解除" Click="OnClear" Padding="8,4"/>
                <Separator/>
                <Button x:Name="ExportButton" Content="💾 .reg 出力" Click="OnExportReg" Padding="8,4"/>
            </ToolBar>
        </ToolBarTray>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="準備完了"/>
            </StatusBarItem>
        </StatusBar>

        <TextBlock DockPanel.Dock="Top" Margin="0,8,0,4" TextWrapping="Wrap" Foreground="#555">
            キーボードを選んで上のボタンでレイアウトを上書きします（複数選択可）。反映には
            <Run FontWeight="SemiBold">USB の抜き差し / Bluetooth の再接続</Run> または再起動が必要です。
        </TextBlock>

        <DataGrid x:Name="DeviceGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Extended"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  CanUserResizeRows="False"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="製品名" Binding="{Binding ProductName}" Width="180"/>
                <DataGridTextColumn Header="接続" Binding="{Binding BusLabel}" Width="90"/>
                <DataGridTextColumn Header="状態" Binding="{Binding ConnectedLabel}" Width="90"/>
                <DataGridTextColumn Header="コレクション" Binding="{Binding CollectionTag}" Width="90"/>
                <DataGridTextColumn Header="識別子" Binding="{Binding Identifier}" Width="190"/>
                <DataGridTextColumn Header="現在のレイアウト" Binding="{Binding CurrentLayoutLabel}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
